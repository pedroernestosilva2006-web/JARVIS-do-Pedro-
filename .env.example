# Copie para apps/web/.env.local (dev) e configure na Vercel (produção). Nunca commite valores reais.

# --- Supabase (supabase status / painel do projeto → API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Só no servidor (workers/webhooks). Ignora RLS — nunca exponha no client.
SUPABASE_SECRET_KEY=sb_secret_...

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- IA ---
# Claude: use UMA das opções. Sem ANTHROPIC_API_KEY, o app usa o Vercel AI Gateway
# (AI_GATEWAY_API_KEY, ou o token OIDC que a Vercel injeta sozinha em runtime).
ANTHROPIC_API_KEY=sk-ant-...
# AI_GATEWAY_API_KEY=...
# No gateway os modelos têm prefixo do provedor (defaults: anthropic/claude-haiku-4.5 e
# anthropic/claude-sonnet-4.5; ajuste JARVIS_EXTRACT_MODEL / JARVIS_CHAT_MODEL se os slugs mudarem).

# Embeddings e transcrição de áudio (OPCIONAL): sem esta chave, a busca usa só palavra-chave,
# não há links semânticos e áudios não são transcritos. Ao configurar depois, o worker preenche o que faltou.
OPENAI_API_KEY=sk-...
# Modelos configuráveis (preços/modelos mudam; não fixe no código)
JARVIS_EXTRACT_MODEL=claude-haiku-4-5
JARVIS_CHAT_MODEL=claude-sonnet-5-5
JARVIS_CHAT_EFFORT=medium
JARVIS_EMBED_MODEL=text-embedding-3-small
# gpt-4o-mini-transcribe sai do ar em 26/02/2027 → troque por gpt-transcribe quando disponível
JARVIS_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# "off" desliga o juiz de relações (camada 3 de linking) para economizar
JARVIS_LINK_JUDGE=on

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_BOT_USERNAME=JarvisDoPedroBot
TELEGRAM_WEBHOOK_SECRET=gere-um-segredo-longo
# Opcional: Local Bot API Server (remove o limite de 20 MB de download)
# TELEGRAM_API_BASE=https://api.telegram.org

# --- Workers (pg_cron → /api/workers/*) ---
CRON_SECRET=gere-outro-segredo-longo
